# Gradle
.gradle/
.kotlin/
build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# Release signing. The keystore and its passwords must never be committed.
# Play App Signing can rotate an upload key, but losing the only key means
# losing the ability to update the app.
*.jks
*.keystore

# Android
*.apk
*.aab
*.ap_
*.dex

# The legacy Android Gradle plugin wrote its release output to a "release"
# directory beside the module. Modern AGP writes it under build/, which is
# already ignored above.
#
# This rule has to stay anchored to the root. An unanchored "release/" also
# matches every directory named "release" at any depth, including
# app/src/release - which is source, and holds the release build's no-op
# test-Pro switch. Leaving it unanchored hid that file from git, so it was
# never committed and a fresh clone could not build the release variant.
/release/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# --- Models ---
#
# The models are large (Whisper base.en int8 is around 250 MB, the Piper voice
# around 63 MB) and they are downloaded, not authored. They are fetched by
# models/fetch-models.sh and must never be committed.
#
# The espeak-ng data is a directory of many small files that the fetch script
# unpacks, so it gets ignored by name rather than by size.

# The sherpa-onnx checkout and the native libraries built from it.
#
# third_party/sherpa-onnx is a git clone of an upstream project, and
# app/src/main/jniLibs is built from it by tools/build-sherpa.ps1. Neither is
# ours to version.
third_party/
app/src/main/jniLibs/

# The models are downloaded by tools/fetch-models.ps1, not committed.
models-pack/src/main/assets/*.onnx
models-pack/src/main/assets/*-tokens.txt
models-pack/src/main/assets/espeak-ng-data/

# The parity corpus itself IS tracked: it is generated by the Python
# implementation in darts-coach-windows and checked in here, because it is
# the specification the Kotlin port is checked against.
#
# The generator lives in the other repo:
#   cd ../darts-coach-windows
#   python tools/parity/parity_gen.py --out ../dart-coach-android/corpus

# Model archives, if fetched into place rather than into a temp dir
*.tar.bz2
*.onnx

# Logs and captures from the device
*.log
session*.wav
levels*.csv
