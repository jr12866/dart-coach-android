<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon: a dartboard seen face on. Concentric rings in the
    colours the coach's screen uses, so the icon and the app look like the
    same thing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer double ring -->
    <path
        android:fillColor="#4ADE80"
        android:pathData="M54,54m-26,0a26,26 0,1 1,52 0a26,26 0,1 1,-52 0" />
    <!-- single ring -->
    <path
        android:fillColor="#0B0F14"
        android:pathData="M54,54m-21,0a21,21 0,1 1,42 0a21,21 0,1 1,-42 0" />
    <!-- treble bed -->
    <path
        android:fillColor="#E8EDF2"
        android:pathData="M54,54m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0" />
    <!-- bull -->
    <path
        android:fillColor="#FFD166"
        android:pathData="M54,54m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
</vector>