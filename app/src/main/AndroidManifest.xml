<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTERNET permission.

        This is here for one thing: the Google Play billing library, which
        talks to the Play Store to take the payment for Darts Coach Pro.

        It is not here for the coach. The ASR, the TTS and the game logic all
        run on the device, and the coach works with no network at all. The
        microphone audio is processed in memory and never sent anywhere: no
        code in this app reads the audio buffer and writes it to a socket,
        and no analytics, crash reporting or advertising SDK is included.

        The claim in the store listing is therefore narrower than it was, not
        withdrawn: the coach needs no network, and the only thing that uses
        one is the purchase.

        RECORD_AUDIO is required, for the microphone. The coach cannot hear
        the player without it.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!--
        The screen orientation is not a hardware requirement.

        The activity below asks for portrait with android:screenOrientation,
        and AAPT2 turns that into an implicit requirement for
        android.hardware.screen.portrait. That is a hardware filter, so Play
        hid the app from devices with no portrait-capable display - tablets,
        desktop and Android XR - and refused to send it for review with
        "Required hardware feature declarations are restricting your app's
        availability".

        Declaring the feature explicitly with android:required="false" is what
        Google's own documentation asks for: it removes the store filter
        without changing the app. The activity still runs portrait on a
        phone, because android:screenOrientation is a runtime request and is
        untouched by this. Nothing about the layout or the coach changes.

        Landscape is declared for the same reason. The app does not ask for
        it, but Play's check covers both orientations, and declaring both
        stops the same issue coming back when the manifest changes.

        See docs/PUBLISHING.md.
    -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DartsCoach">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DartsCoach">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
